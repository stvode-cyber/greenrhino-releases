{
  "name": "offline-player",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "离线媒体播放器 PWA — 音乐 + 视频双模式，离线优先（零构建，原生 ES Module）",
  "scripts": {
    "dev": "python -m http.server 4173",
    "serve": "python -m http.server 4173",
    "test": "node --test \"test/*.test.js\"",
    "test:build": "node --test test/build-sw-cache.test.js",
    "test:e2e": "npx playwright test test/e2e/sw-cache.spec.js",
    "test:e2e:reuse": "PLAYWRIGHT_REUSE=1 npx playwright test test/e2e/sw-cache.spec.js",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "jsmediatags": "^3.9.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^5.4.10"
  }
}
