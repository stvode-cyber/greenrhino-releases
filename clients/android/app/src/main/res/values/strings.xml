<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">绿角犀播放器</string>

    <!-- 部署后的 PWA 地址：把 web 应用托管到该 https 域名，并在其根部署 /.well-known/assetlinks.json -->
    <string name="app_url">https://greenrhino.example.com/</string>
    <string name="app_host">greenrhino.example.com</string>

    <!-- 数字资产委托（与站点 /.well-known/assetlinks.json 对应） -->
    <string name="asset_statements">[{\"relation\":[\"delegate_permission/common.handle_all_urls\"],\"target\":{\"namespace\":\"web\",\"site\":\"https://greenrhino.example.com\"}}]</string>

    <string name="twa_service">@string/app_name</string>
</resources>
